{
  "name": "solflare-qa-assignment",
  "version": "1.0.0",
  "description": "WebdriverIO E2E and API tests for the Solflare wallet",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:headless": "wdio run wdio.conf.ts --headless --browser=firefox",
    "test:api": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/ui": "^5.0.5",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/logger": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "expect-webdriverio": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "webdriverio": "^10.1.0"
  }
}
